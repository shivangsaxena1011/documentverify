# Database Persistence
# Prisma SQLite for local development: "file:./dev.db"
# Dedicated PostgreSQL / MySQL URI recommended for production cloud deployments
DATABASE_URL="file:./dev.db"

# Environment & Server Config
NODE_ENV="development"
PORT=3000

# Authentication & Session Security
# MANDATORY IN PRODUCTION: Provide a strong, high-entropy secret (at least 32 characters)
# Application will fail closed in production if this variable is not defined.
JWT_SECRET="replace-with-a-secure-random-32-char-secret-in-production"
SESSION_EXPIRY_HOURS="12"

# OCR Service Provider Configuration
# Supported providers: TESSERACT | GOOGLE_CLOUD_VISION | AZURE_DOC_INTELLIGENCE
OCR_PROVIDER="TESSERACT"
OCR_CONFIDENCE_THRESHOLD="65"
GOOGLE_CLOUD_VISION_API_KEY=""
AZURE_DOC_INTELLIGENCE_KEY=""
AZURE_DOC_INTELLIGENCE_ENDPOINT=""

# TRISHUL Criminal Network Intelligence Hub Integration
# Cryptographic dispatch endpoint and API key for TRISHUL central node
TRISHUL_CENTRAL_ENDPOINT="https://api.trishul-intel.internal/v1/screening/ingest"
TRISHUL_API_KEY="placeholder-trishul-api-key"
TRISHUL_ORGANIZATION_ID="APEX-VERIF-HQ-09"
TRISHUL_TRANSMISSION_MODE="METADATA_AND_EVIDENCE"

# Verification Gateway (Institutional & AICTE Connector)
# When unauthorized or missing credentials, connectors operate in Source Unavailable / Manual Review state
VERIFICATION_GATEWAY_URL=""
VERIFICATION_GATEWAY_KEY=""
AICTE_PORTAL_API_URL=""
AICTE_PORTAL_CLIENT_ID=""
AICTE_PORTAL_CLIENT_SECRET=""

# Data Retention & Privacy Policy (Days to keep document images; 0 for instant purge)
DOCUMENT_RETENTION_DAYS="30"
ALLOW_OPERATOR_PII_UNMASK="true"
ENABLE_BIOMETRICS="true"
